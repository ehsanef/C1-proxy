{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "c1-proxy",
  "main": "src/index.ts",
  "compatibility_date": "2024-12-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "c1-proxy-db",
      "database_id": "58acadb8-2fe8-46f4-b0d5-31b1609b815b"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "dfc8b2475c874a6ab88a7a5b522efedf"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "C1_VERSION": "1.0.0"
  },
  "observability": {
    "enabled": true
  }
}
