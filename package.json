{
  "name": "c1-proxy",
  "version": "1.0.0",
  "description": "Self-hosted, edge-native secure proxy control plane for Cloudflare Workers",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "c1-proxy",
    "cloudflare-workers",
    "proxy",
    "vless",
    "trojan",
    "shadowsocks",
    "edge-computing",
    "control-plane"
  ],
  "author": "C1 Proxy Team",
  "license": "MIT",
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241230.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "wrangler": "^3.99.0"
  }
}
